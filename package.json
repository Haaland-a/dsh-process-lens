{
  "name": "dsh-process-lens",
  "version": "0.10.2",
  "type": "module",
  "description": "过程讲解器 —— 把 AI 的处理过程翻译成大白话。讲解模型可单独选，什么时候讲由你决定，调用了工具的步骤不花调用。",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "process",
    "explain",
    "deepseek"
  ],
  "author": "Haaland-a",
  "license": "MIT",
  "homepage": "https://github.com/Haaland-a/dsh-process-lens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Haaland-a/dsh-process-lens.git"
  },
  "bugs": {
    "url": "https://github.com/Haaland-a/dsh-process-lens/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/Haaland-a/dsh-process-lens/archive/refs/heads/main.tar.gz",
      "zip": "https://github.com/Haaland-a/dsh-process-lens/archive/refs/heads/main.zip",
      "git": "https://github.com/Haaland-a/dsh-process-lens.git"
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.1 <0.3.0",
      "profiles": [
        "desktop",
        "web"
      ],
      "dshReleases": {
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "engines": {
    "node": ">=18"
  }
}
